// EP Strategy — the same rules as EP Engine, as a backtestable strategy (Pine v6)
// Use on a 5-min chart (Strategy Tester bars are limited by your plan) or on a daily chart with
// "Daily approximation" on (entry = break of day-1 high... see below).
//@version=6
strategy("EP Strategy", "EP Strategy", overlay = true, pyramiding = 0, calc_on_every_tick = false,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_order, commission_value = 1)

grpS = "Setup gates"
gapMin      = input.float(8.0,  "Gap % minimum", group = grpS)
volRatioMin = input.float(1.0,  "Volume ÷ 30d ADV minimum", group = grpS)
ret3mMax    = input.float(30.0, "Max 3-month pre-gap return %", group = grpS)
useRegime   = input.bool(true, "Require regime green (QQQ 10>20 rising)", group = grpS)
grpE = "Entry / stop / size"
orMinutes   = input.int(5, "Opening range minutes", options = [1, 5, 15, 30, 60], group = grpE)
adrLen      = input.int(20, "ADR length", group = grpE)
maxStopADR  = input.float(1.0, "Max stop (× ADR) — skip if wider", step = 0.25, group = grpE)
riskPct     = input.float(0.25, "Risk % of equity per trade", step = 0.05, group = grpE)
grpX = "Exit variants"
trailLen    = input.int(10, "Trail MA (daily closes)", options = [10, 20, 50], group = grpX)
beADR       = input.float(1.0, "Breakeven after close ≥ entry + n×ADR", step = 0.25, group = grpX)
partialOn   = input.bool(false, "Sell 1/3 at day-3 close", group = grpX)
regimeSym   = input.symbol("NASDAQ:QQQ", "Regime symbol", group = grpS)

// fix: without lookahead_on, request.security returns the LAST CONFIRMED daily bar on historical intraday bars, so the
// fix: backtest was gating on YESTERDAY's open/volume/close (and two-day-old [1] values). Completed-bar values now use
// fix: the documented non-repainting form ([1] offset + lookahead_on); today's open/volume/close come from chart bars.
[dPrevClose, dADV30, dADR, dRet3m, dSumTrailPrev] =
     request.security(syminfo.tickerid, "D",
         [close[1], ta.sma(volume, 30)[1], ta.sma(high / low - 1, adrLen)[1] * 100,
          (close[1] / close[64] - 1) * 100, math.sum(close, trailLen - 1)[1]], lookahead = barmerge.lookahead_on)
// Regime as of the prior daily close. fix: [1]/[4] + lookahead_on so history == realtime.
[qS10, qS20, qS10p, qS20p] = request.security(regimeSym, "D", [ta.sma(close, 10)[1], ta.sma(close, 20)[1], ta.sma(close, 10)[4], ta.sma(close, 20)[4]], lookahead = barmerge.lookahead_on)
regimeGreen = qS10 > qS20 and qS10 > qS10p and qS20 > qS20p

endMin = 30 + orMinutes
endHH  = 9 + math.floor(endMin / 60)
endMM  = endMin % 60
sessOR = "0930-" + (endHH < 10 ? "0" : "") + str.tostring(endHH) + (endMM < 10 ? "0" : "") + str.tostring(endMM) + ":23456"
inOR    = not na(time(timeframe.period, sessOR, "America/New_York"))
inRTH   = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
lateRTH = not na(time(timeframe.period, "1550-1600:23456", "America/New_York"))
newDay  = timeframe.change("D")   // fix: v6-idiomatic new-day detection (was ta.change(time("D")) != 0)
dayIdx  = int(ta.cum(newDay ? 1 : 0))   // fix: ta.cum returns float; entryDay is int, so cast or `entryDay := dayIdx` fails

var float orh = na
var float orl = na
var bool  orDone = false
var bool  armed = false
var int   entryDay = na
var float stopLvl = na
var bool  be = false
var bool  partialDone = false
var float dOpen = na    // fix: today's regular-session open, captured on the first OR bar
var float dVol  = 0.0   // fix: today's cumulative volume from the chart bars
if newDay
    orh := na
    orl := na
    orDone := false
    armed := false
    dOpen := na
    dVol  := 0.0
if inOR
    orh := na(orh) ? high : math.max(orh, high)
    orl := na(orl) ? low  : math.min(orl, low)
    dOpen := na(dOpen) ? open : dOpen
if not inOR and inRTH and not na(orh)
    orDone := true
dVol += nz(volume)

// fix: today's live values from the chart (moved below the session block they depend on)
dClose    = close
dSMAtrail = (dSumTrailPrev + close) / trailLen
gapPct    = (dOpen / dPrevClose - 1) * 100
volRatio  = dADV30 > 0 ? dVol / dADV30 : na

maxStopAbs = close * dADR / 100 * maxStopADR
setupValid = orDone and gapPct >= gapMin and volRatio >= volRatioMin and dRet3m <= ret3mMax and (orh - orl) <= maxStopAbs and (not useRegime or regimeGreen)

// Arm a stop-market buy at the OR high once the OR completes on a valid setup (day 1 only).
if setupValid and not armed and strategy.position_size == 0 and inRTH
    riskDollars = strategy.equity * riskPct / 100
    qty = math.max(1, math.floor(riskDollars / (orh - orl)))
    strategy.entry("EP", strategy.long, qty = qty, stop = orh, comment = "ORH")
    strategy.exit("stop", "EP", stop = orl, comment = "OR-low stop")   // fix: protective stop armed with the entry, so the fill bar is covered
    armed := true
// fix: on an RTH-only chart `not inRTH` is never true (no bars outside 0930-1600), so the stop-buy survived overnight
// fix: and could fill on the next day's open. Cancel on the last regular-session bar as well.
if armed and (not inRTH or session.islastbar_regular) and strategy.position_size == 0
    strategy.cancel("EP")   // unfilled by the close → cancel; no overnight orders
    strategy.cancel("stop")
    armed := false

justEntered = strategy.position_size > 0 and strategy.position_size[1] == 0
if justEntered
    entryDay := dayIdx
    stopLvl := orl
    be := false
    partialDone := false

if strategy.position_size > 0
    // breakeven after a daily close ≥ entry + n×ADR
    if not be and lateRTH and dClose >= strategy.position_avg_price * (1 + beADR * dADR / 100)
        be := true
        stopLvl := strategy.position_avg_price
    strategy.exit("stop", "EP", stop = stopLvl, comment = be ? "BE stop" : "OR-low stop")
    // optional partial: 1/3 at the day-3 close
    if partialOn and not partialDone and lateRTH and dayIdx - entryDay == 3
        strategy.close("EP", qty_percent = 33.3, comment = "1/3 day3")
        partialDone := true
    // trail: first daily close below the MA (after day 1) → out at that close
    if lateRTH and dayIdx > entryDay and dClose < dSMAtrail
        strategy.close("EP", comment = "close < MA" + str.tostring(trailLen))

plot(orDone ? orh : na, "OR high", color.lime, style = plot.style_linebr)
plot(orDone ? orl : na, "OR low", color.red, style = plot.style_linebr)
plot(strategy.position_size > 0 ? stopLvl : na, "Stop", color.orange, style = plot.style_linebr)
bgcolor(setupValid and not setupValid[1] ? color.new(color.green, 85) : na)
